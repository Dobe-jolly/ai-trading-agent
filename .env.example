# Copy to /etc/nmbz-agents/agents.env (systemd) or .env in the project folder (manual runs) and fill in.
# One KEY=value per line, no spaces around "=", no inline comments, no quotes.
#
# One file for every desk. A setting without a prefix applies to every desk; the same setting with a
# desk's prefix applies to that desk only and wins there:
#     AGENT_MODE=shadow            every desk decides and logs only...
#     ECOCASH_AGENT_MODE=live      ...except EcoCash, which acts
# Prefixes: ROUTER_ (router), SMS_ALERTS_ (SMS Alerts desk), ECOCASH_ (EcoCash desk), FAILED_TXN_ (failed transactions),
# NMB_CONNECT_ (NMB Connect registration and login).
# Names shared with the Java agents (METABASE_*, *_DB_NAME, SMS_SOCKET_*, NOTIF_*, ...) keep their meaning.

# ---- The service -------------------------------------------------------------------------------
# Desks a pass visits, in order (python -m nmbz run). Remove one to switch it off. The router goes first:
# a ticket it files under a desk's topic is picked up by that desk in the same pass.
DESKS=router,sms_alerts,ecocash,failed_txn,nmb_connect
# If this file exists no desk runs (the console's "Pause every desk" writes it). Each desk also has its
# own pause, state/<desk>/STOP. Do not set KILL_SWITCH_FILE, MODE_OVERRIDE_FILE or STATE_DB without a
# desk prefix: each desk keeps its own (state/<desk>/...).
SERVICE_KILL_SWITCH_FILE=state/STOP

# ---- Claude (the reasoning) ---------------------------------------------------------------------
# Approved for use across the bank (October 2026). The agent host calls https://api.anthropic.com (outbound 443);
# `python -m nmbz check --ping-model` proves it can. Through the bank's proxy, set HTTPS_PROXY here (systemd passes
# this file to the service) and list Metabase and the notification gateway in NO_PROXY by host name or IP: ranges
# such as 192.168.0.0/16 are not understood there.
# HTTPS_PROXY=http://proxy.example:8080
# NO_PROXY=localhost,127.0.0.1,192.168.243.65
ANTHROPIC_API_KEY=
# Until there is an API key: a Claude subscription (Team or Enterprise seat) through the Claude Agent SDK.
# Make the token with `claude setup-token` (lasts a year), paste it here and leave ANTHROPIC_API_KEY empty.
# Needs `pip install claude-agent-sdk` (Python 3.10+). The same masking, lookups and rules apply; usage counts
# against that person's subscription limits. MODEL_BACKEND: auto = the API with a key, the SDK with only a
# token; api or agent_sdk forces one.
CLAUDE_CODE_OAUTH_TOKEN=
MODEL_BACKEND=auto
AGENT_MODEL=claude-sonnet-5-5
AGENT_MAX_TURNS=10
# If Claude cannot be reached: rules = each desk's rules decide what they safely can (SMS: the ported Java
# rules; EcoCash: the standard reply for the latest attempt), else escalate; none = wait for the next pass.
MODEL_FALLBACK=rules

# ---- Behaviour (every desk; prefix to change one desk) -------------------------------------------
# shadow = decide and log only | notes = internal recommendation notes | live = reply/close/escalate
AGENT_MODE=shadow
CONFIDENCE_THRESHOLD=0.85
MAX_TICKETS_PER_RUN=25
MAX_CLOSES_PER_RUN=20
# Ask the ticket owner for missing or wrong details instead of escalating
ALLOW_REQUEST_INFO=true
# Agent replies on one ticket before a person takes over
MAX_INFO_REQUESTS=2
# model = Claude writes the reply | template = post the desk's standard wording when it fits
REPLY_SOURCE=model
# Re-examine an unchanged open ticket after this many hours (data may have been fixed meanwhile)
RECHECK_AFTER_HOURS=24
# Escalate if the ticket owner has not answered the agent's question within this many hours
REQUEST_INFO_TIMEOUT_HOURS=72
# Which replies wait for a person in the console (live mode): off | unscripted (the agent reasoned beyond
# the desk's standard outcome, or chose an action it doesn't give) | all
APPROVAL_MODE=unscripted
# Branch changes awaiting authorisation (Intellect maker-checker). One SELECT using {account}, {internal}
# or {client}. Empty = the lookup is hidden. Waiting for the Intellect table names.
PENDING_CHANGES_SQL=

# ---- osTicket writes ------------------------------------------------------------------------------
# The staff account the agents post as (the Java's --reply-staff-id); a desk can have its own
# (ECOCASH_REPLY_STAFF_ID=...). Required for notes and live.
REPLY_STAFF_ID=525
CLOSE_STATUS_ID=3

# ---- Metabase (all data access goes through it) --------------------------------------------------
METABASE_HOST=http://192.168.243.65:3000
METABASE_API_KEY=
METABASE_TIMEOUT_SECONDS=180
METABASE_QUERY_RETRY_COUNT=3
METABASE_QUERY_RETRY_DELAY_MILLIS=5000
METABASE_VERIFY_TLS=true
# Database names as Metabase shows them (resolved to ids at the start of each pass)
TICKET_DB_NAME=OSTICKETS_NEW
STANDBY_DB_NAME=STANDBY DB

# ---- Ticket attachments (screenshots, forms, PDFs, spreadsheets) ---------------------------------
# model = text files read here, images and PDFs read by the model (the file itself is sent)
# local = text files only; images and PDFs listed, not read | off = ignore attachments
ATTACHMENT_MODE=model
# Empty = AGENT_MODEL
ATTACHMENT_MODEL=
ATTACHMENT_MAX_MB=10
# Files read per ticket; the ticket owner's newest files first
ATTACHMENT_MAX_FILES=6
# Inline images smaller than this are e-mail signature logos
ATTACHMENT_MIN_INLINE_KB=10
ATTACHMENT_MAX_TEXT_CHARS=2500

# ---- Console (python -m nmbz portal) --------------------------------------------------------------
# One console for every desk. Bind to localhost and publish through the F5 / nginx with TLS.
# Users: python -m nmbz portal-user add <name> --role admin
PORTAL_HOST=127.0.0.1
PORTAL_PORT=8085
PORTAL_USERS_FILE=state/portal_users.json
# A desk's health strip (and GET /healthz) turns red when it has not finished a pass for this long
PORTAL_STALE_MINUTES=40
# Link ticket numbers to osTicket; {ticket_id} or {number} is filled in
OSTICKET_TICKET_URL=
# Optional: show model cost instead of tokens (your contracted price per million tokens)
PRICE_INPUT_PER_MTOK=
PRICE_OUTPUT_PER_MTOK=
# Console address put in admin alerts, e.g. https://helpdesk-agents.nmbz.co.zw
PORTAL_URL=
# What staff teach a desk from a ticket's "Teach the agent" step (README: Teaching a desk). Switched-on notes
# share this many characters of each desk's prompt, newest first; the Knowledge page shows any left out.
KNOWLEDGE_MAX_CHARS=16000
# Past cases (docs/retrieval.md): build them nightly with `python -m nmbz --desk <desk> cases build`, then switch on
# the find_past_cases lookup per desk (e.g. FAILED_TXN_CASES=on). Cases older than CASES_DAYS are never offered; a
# case's rank halves every CASES_HALF_LIFE_DAYS.
CASES=off
CASES_DAYS=365
CASES_HALF_LIFE_DAYS=90

# ---- Branch e-mails ---------------------------------------------------------------------------------
# The agents write replies straight into osTicket, which sends no alert for them, so they e-mail the
# person who raised the ticket. off | gateway (bank notification gateway) | mailapi (bank mail API) | smtp.
# Empty = gateway whenever NOTIF_EMAIL_URL is set.
NOTIFY_TRANSPORT=
NOTIFY_ON=request_info,reply_and_close
NOTIFY_CC=
# Last line of every e-mail; \n for a line break
NOTIFY_SIGNATURE=ICT Service Desk
# Link in the e-mail for the branch to open the ticket; {ticket_id} or {number} is filled in
OSTICKET_CLIENT_URL=
NOTIFY_MAX_ATTEMPTS=5
# gateway transport (values from the Java sms-agent.env)
NOTIF_EMAIL_URL=
NOTIF_EMAIL_ACCESS_TOKEN=
NOTIF_GATEWAY_BASIC_AUTH=
# mailapi transport: the bank mail API (operation SEND_EMAIL). One request per e-mail; cc addresses join "to"
# and uuid is the e-mail's own id. Keep the token only here, never in code or chat; prefer an https:// URL
# where the API offers one (over http:// the token crosses the network in clear text).
MAIL_API_URL=
MAIL_API_TOKEN=
MAIL_API_CHANNEL=NMB_MOBILE
# smtp transport (lets branches answer by replying to the e-mail)
SMTP_HOST=
SMTP_PORT=25
SMTP_STARTTLS=true
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=ICT Service Desk
SMS_ALERTS_SMTP_FROM_NAME=SMS Alerts agent
ECOCASH_SMTP_FROM_NAME=EcoCash agent
FAILED_TXN_SMTP_FROM_NAME=Failed transactions agent
NMB_CONNECT_SMTP_FROM_NAME=NMB Connect agent
# The mailbox osTicket fetches; replies to it with [#number] in the subject land on the ticket
NOTIFY_REPLY_TO=

# ---- Anomaly watch and admin alerts -----------------------------------------------------------------
# Each desk watches its own signals once an hour and alerts admins on an incident
ANOMALY_ENABLED=true
ANOMALY_INTERVAL_MINUTES=60
ANOMALY_WINDOW_HOURS=24
ANOMALY_BASELINE_DAYS=14
ANOMALY_MIN_TICKETS=5
# Alert admins at: incident | watch
ANOMALY_ALERT_LEVEL=incident
ANOMALY_REALERT_HOURS=4
# Empty = AGENT_MODEL
ANOMALY_MODEL=
# Comma separated; SMS through the gateway (Java AdminNotifGateway), e-mail through NOTIFY_TRANSPORT
ADMIN_SMS_RECIPIENTS=
ADMIN_EMAIL_RECIPIENTS=
NOTIF_SMS_URL=
NOTIF_SMS_ACCESS_TOKEN=
NOTIF_SMS_ORIGINATOR=NMB Bank

# =====================================================================================================
# SMS Alerts desk (prefix SMS_ALERTS_)
# =====================================================================================================
# Its own help topics (and their subtopics)
SMS_HELP_TOPICS=SMS Alerts
# Also read open tickets under other topics from the last SCAN_OTHER_TOPICS_DAYS days and handle the ones
# that are about SMS alerts (branches sometimes pick the wrong topic)
SCAN_OTHER_TOPICS=true
SCAN_OTHER_TOPICS_DAYS=30
# Topics another desk owns: never read
EXCLUDE_TOPICS=EcoCash,Failed ZIPIT Transaction,Ecocash / Failed Transactions,FAILED ECOCASH B2W / WB2,NMB Connect / Failed Transaction,FAILED AIRTIME PURCHASE,FAILED ZESA,Postilion transactions,NMB Connect / USSD / Failed Transactions
# Model for the short "is this about SMS alerts?" read (empty = AGENT_MODEL; a small model is enough)
TRIAGE_MODEL=
TRIAGE_MAX_PER_RUN=40
TRIAGE_MIN_CONFIDENCE=0.8
# Read-only lookups beyond the standard check (account activity, gateway messages, profile)
LOOKUPS_ENABLED=true
# Statuses that must be corrected with the ticket owner, never closed
NO_CLOSE_STATUSES=invalid_account_number,invalid_ticket_phone
# CAE -> dispatch -> gateway trace for escalation notes (heavy queries, at most once per ticket)
PIPELINE_TRACE_ENABLED=true
CUSTOMERS_DB_NAME=CUSTOMERS
SOCKET_SMS_DB_NAME=SOCKET SMS DB
DISPATCH_SMS_DB_NAME=SMS
STANDBY_REPLY_SOURCE_NAME=Intellect
SMS_LOOKBACK_DAYS=15
# Core banking keeps one transaction table per year; {year} is filled from the dates checked
TRAN_TABLE_PATTERN=NMBPRODIDC.TRAN{year}
SMS_SOCKET_CHECK_ENABLED=true
SMS_SOCKET_MATCH_WINDOW_MINUTES=60
SMS_SOCKET_DISPATCH_LAG_MINUTES=1080
SMS_SOCKET_OVERSEND_THRESHOLD=5
SMS_SOCKET_MAX_TRIGGERS=5
SMS_SALARIES_REQUIRE_DELIVERY_PROOF=false
# Anomaly watch: below this many gateway sends in 24 h, delivery rates are not judged
ANOMALY_MIN_SENDS=200
SMS_ALERTS_ANOMALY_SAMPLE_SIZE=600

# =====================================================================================================
# EcoCash desk (prefix ECOCASH_)
# =====================================================================================================
# Help topics (and their subtopics) it owns
ECOCASH_HELP_TOPICS=EcoCash
# Also open tickets under other topics that mention these, created in the last ECOCASH_CONTENT_DAYS days;
# they cost no model call unless the owner's details have a link attempt
ECOCASH_KEYWORDS=ecocash,eco cash
ECOCASH_CONTENT_DAYS=30
# Never touched (other desks own these, including the failed-transaction topics under EcoCash)
ECOCASH_EXCLUDE_TOPICS=SMS Alerts,Failed ZIPIT Transaction,Ecocash / Failed Transactions,FAILED ECOCASH B2W / WB2,NMB Connect / Failed Transaction,FAILED AIRTIME PURCHASE,FAILED ZESA,Postilion transactions,NMB Connect / USSD / Failed Transactions
# How far back the lookups go
ECOCASH_LOOKBACK_DAYS=60
# The EcoCash monitor's database. Until the Python monitor writes ecocash_link_attempts, this is the Java
# monitor's (failed_ecocash_registrations: failures only); point it at the monitor's database once it runs.
ECOCASH_DB_NAME=Ecocash erros
# Postilion's realtime database, which has eftc_ecocash
POSTILION_DB_NAME=Postilion Realtime
ECOCASH_ATTEMPTS_TABLE=ecocash_link_attempts
# The Java monitor's failures table, read for history from before the switch (empty = don't)
ECOCASH_LEGACY_TABLE=failed_ecocash_registrations
POSTILION_ECOCASH_TABLE=eftc_ecocash
# Optional core-banking extras, run with {internal} (internal account) and {client} (client number)
CORE_SQL_ACCOUNT_STATUS=
CORE_SQL_ID_ON_FILE=
# Anomaly watch: below this many link requests in 24 h, rates are not judged
ANOMALY_MIN_ATTEMPTS=30
ECOCASH_ANOMALY_SAMPLE_SIZE=400
# The monitor (python -m nmbz monitor) runs on the integrations host with its own env file:
# see deploy/monitor.env.example.

# =====================================================================================================
# Failed-transactions desk (prefix FAILED_TXN_)
# =====================================================================================================
# Help topics (and their subtopics) it owns
FAILED_TXN_HELP_TOPICS=Failed ZIPIT Transaction,Ecocash / Failed Transactions,FAILED ECOCASH B2W / WB2,NMB Connect / Failed Transaction,FAILED AIRTIME PURCHASE,FAILED ZESA,Postilion transactions,NMB Connect / USSD / Failed Transactions
FAILED_TXN_EXCLUDE_TOPICS=
# With no date on the ticket the lookups cover this many days; with a date, this many days either side
FAILED_TXN_LOOKBACK_DAYS=30
FAILED_TXN_DATE_WINDOW_DAYS=3
# Where the transactions are (Metabase names). A database that is not found only switches its lookup off.
POST_OFFICE_DB_NAME=POST OFFICE
CONECT_DB_NAME=CONECT 2.0
BILLERS_DB_NAME=BILLERS
IB_DB_NAME=IB
# Postilion table: post_tran_leg (the bank's report query: transaction names from the nodes, the merchant) or
# post_tran (the columns the Java investigator read)
POSTILION_TABLE=post_tran_leg
# EcoCash links (which account a client's EcoCash wallet is linked to): the bank's registration log. A database
# that is not found only switches the lookup off.
ECOCASH_REG_DB_NAME=Ecocash Reg
ECOCASH_REG_TABLE=public.ecocash_registration
# query_data: the agent's read-only look into the approved tables of the bank's other databases
# (agentcore/data_catalogue.json; `check` tests each table without reading rows). QUERY_DATA=false turns it off.
# QUERY_DATA=true
# DATA_CATALOGUE=agentcore/data_catalogue.json
# explore_data / query_tables: the agent explores what the approved databases hold (names and types only) and reads
# up to three joined tables of one database (agentcore/schema/*.json, built by tools/build_schema.py; personal
# columns are not in those files). QUERY_TABLES=false turns it off.
# QUERY_TABLES=true
# SCHEMA_DIR=agentcore/schema
# log_errors / log_search: the agent's look into the ingested application logs (docs/logs.md). Logs are masked when they
# are ingested (python -m agentcore.logs ingest ...); LOG_HASH_KEY (16+ characters, secret, never in git) keys the
# hashes that stand in for account and mobile numbers, so a ticket's account can be searched without any being kept.
# Without a key or a store the tools are simply off. QUERY_LOGS=false turns them off.
# QUERY_LOGS=true
# LOG_DB=state/logs.db
# LOG_HASH_KEY=
# QUERY_CLOSE=true lets a ticket close on what query_data found for the ticket owner, once core banking's postings
# were checked and agree with the reply about the money (docs/failed_txn.md). Off by default.
# QUERY_CLOSE=false
# Core banking reads go to STANDBY_DB_NAME (above), never the live system; TRAN_TABLE_PATTERN as for SMS Alerts.
# Start it in shadow while the other desks act, e.g.:
# FAILED_TXN_AGENT_MODE=shadow

# =====================================================================================================
# NMB Connect desk (prefix NMB_CONNECT_): registration, login, OTP, forgotten username, accounts not showing
# =====================================================================================================
# Help topics (and their subtopics) it owns; failed transactions under them are left to the failed-transactions desk
NMB_CONNECT_HELP_TOPICS=NMB Connect / Registration,NMB Connect / OTP,NMB Connect / Account,NMB Connect / System Issue,NMB Connect / USSD,USSD / Account,USSD / System Error,USSD / Pin
NMB_CONNECT_EXCLUDE_TOPICS=NMB Connect / USSD / Failed Transactions
# The NMB Connect registrations (Metabase name). Required.
CONECT_REG_DB_NAME=CONECT 2.0 REG
# Its tables. The profile table is read whole and filtered in code (python -m nmbz check --desk nmb_connect lists
# the columns); channels and history are read when they exist.
NMB_CONNECT_PROFILE_TABLE=customers
NMB_CONNECT_CHANNELS_TABLE=user_channels
NMB_CONNECT_HISTORY_TABLE=history
# The registration log analyzer's database (registration_failures), once it is in Metabase. Empty: lookup off.
REG_FAILURES_DB_NAME=
# App and USSD activity come from CONECT_DB_NAME, OTP delivery from SOCKET_SMS_DB_NAME, accounts and the mobile on
# file from STANDBY_DB_NAME (all above). How far back activity and SMS go, in days:
NMB_CONNECT_ACTIVITY_DAYS=14
NMB_CONNECT_SMS_DAYS=7
# Start it in shadow while the other desks act, e.g.:
# NMB_CONNECT_AGENT_MODE=shadow

# =====================================================================================================
# Trading Agent (prefix TRADING_): forex, gold, and volatility indices via MetaTrader 5 on Deriv
# =====================================================================================================
# MT5 terminal credentials (Deriv demo account)
TRADING_MT5_LOGIN=
TRADING_MT5_PASSWORD=
TRADING_MT5_SERVER=Deriv-Demo

# paper = simulate trades in SQLite (safe default) | live = execute real trades via MT5
TRADING_MODE=paper

# Symbols to scan each run (comma-separated; exact names as shown in MT5)
TRADING_SYMBOLS=EURUSD,GBPUSD,XAUUSD,Volatility 75 Index,Volatility 25 Index

# Primary timeframe for initial analysis
TRADING_PRIMARY_TIMEFRAME=H1

# Risk controls (code-enforced — the model cannot override these)
TRADING_MAX_POSITIONS=3
# New positions allowed in one scan, across all symbols
TRADING_MAX_NEW_OPENS_PER_SCAN=3
# Open positions allowed to lean the same way (buys or sells) across all symbols; 0 = no cap
TRADING_MAX_SAME_DIRECTION=3
# Told to the model only (not checked in code): synthetic index positions at one time
TRADING_MAX_SYNTHETIC_POSITIONS=3
# A stop must be at least this many H1 ATRs from entry, measured live for each symbol (0 = no check)
TRADING_MIN_STOP_ATR=1.0
TRADING_MAX_RISK_PCT=1.0
TRADING_DAILY_LOSS_LIMIT_PCT=5.0
# Cap on risk across all open trades combined, % of balance (a new trade is trimmed or blocked)
TRADING_MAX_TOTAL_RISK_PCT=40.0
# No new forex/metal opens in these UTC windows (daily rollover); synthetics are unaffected. Empty disables.
TRADING_BLACKOUT_UTC=21:00-22:00
# No new opens while broker ping is above this (ms). 0 disables.
TRADING_MAX_LATENCY_MS=1000
# Forex/metals whose last quote is this many minutes older than the freshest quote on the list are treated as closed
# (weekends) and skipped without a model call. 0 disables.
TRADING_MARKET_STALE_MIN=30
# After the daily loss limit trips, make no model calls for this many hours (delete state/LOCKOUT.<mode> to lift early)
TRADING_LOCKOUT_HOURS=24
TRADING_SPREAD_MAX_PIPS=5.0
TRADING_CONFIDENCE_THRESHOLD=0.72

# =====================================================================================================
# Router (prefix ROUTER_): files tickets from catch-all topics under the topic they belong to
# =====================================================================================================
# Catch-all topics it reads (subtopics included), and whether tickets with no help topic are read too
ROUTER_TOPICS=HelpDesk / Logging Ticket
ROUTER_INCLUDE_NO_TOPIC=true
# Only tickets opened in the last this many days
ROUTER_DAYS=30
# Never read tickets under these, even within a catch-all
ROUTER_EXCLUDE_TOPICS=
# Never a target: topics that say where a ticket stands rather than what it is about
ROUTER_NEVER_TO=Escalated to Vendor
# It moves a ticket on its own only to a topic a desk works. Topics listed here are moved to on their own too
# (subtopics included); any other topic is suggested to staff in a note.
ROUTER_MOVE_TO=
ROUTER_MAX_MOVES_PER_RUN=20
# How far back it looks at closed tickets to see where similar ones were filed
ROUTER_EXAMPLES_DAYS=365
# What each topic is for, as the model sees it (edit it; osTicket's own topic notes fill the gaps)
ROUTER_TOPIC_DESCRIPTIONS_FILE=router/topic_descriptions.json
# The router only e-mails when it asks a branch to describe the problem
ROUTER_NOTIFY_ON=request_info
ROUTER_SMTP_FROM_NAME=Routing agent
# The router does not follow AGENT_MODE: it stays in shadow until this is set (it changes help topics)
# ROUTER_AGENT_MODE=notes
