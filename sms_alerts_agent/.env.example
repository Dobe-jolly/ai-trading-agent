# Copy to /etc/sms-alerts-agent/agent.env (systemd) or .env (manual runs) and fill in.
# One KEY=value per line, no spaces around "=", no inline comments, no quotes.
# Names shared with the Java sms-agent keep the Java's meaning, so values can be copied across.

# ---- Claude (the reasoning) -----------------------------------------------------
ANTHROPIC_API_KEY=
AGENT_MODEL=claude-sonnet-5-5
AGENT_MAX_TURNS=10
# If Claude cannot be reached: rules = decide with the ported Java rules (close only when every
# check passes, else escalate); none = leave the ticket for the next run.
MODEL_FALLBACK=rules

# ---- Behaviour ------------------------------------------------------------------------
# shadow = decide and log only | notes = internal recommendation notes | live = reply/close/escalate
AGENT_MODE=shadow
CONFIDENCE_THRESHOLD=0.85
MAX_TICKETS_PER_RUN=25
MAX_CLOSES_PER_RUN=20
# Ask the ticket owner for a missing/wrong account or phone instead of closing
ALLOW_REQUEST_INFO=true
# Agent replies on one ticket before it hands over to a person instead of asking again
MAX_INFO_REQUESTS=2
# Statuses that must be corrected with the ticket owner, never closed
NO_CLOSE_STATUSES=invalid_account_number,invalid_ticket_phone
# model = Claude writes the reply | template = post the Java's exact wording on closes
REPLY_SOURCE=model
# CAE -> dispatch -> gateway trace for escalation notes (heavy queries, at most once per ticket)
PIPELINE_TRACE_ENABLED=true
# Re-examine an unchanged open ticket after this many hours (data may have been fixed meanwhile)
RECHECK_AFTER_HOURS=24
# If this file exists the agent does nothing: touch it to stop, rm it to resume
KILL_SWITCH_FILE=state/STOP

# ---- Which tickets -----------------------------------------------------------------------------
# The agent's own help topics (and their subtopics)
SMS_HELP_TOPICS=SMS Alerts
# Also read every open ticket under other topics (or none) from the last SCAN_OTHER_TOPICS_DAYS days,
# and handle the ones that are about SMS alerts (branches sometimes pick the wrong topic)
SCAN_OTHER_TOPICS=true
SCAN_OTHER_TOPICS_DAYS=30
# Topics another agent owns: never read
EXCLUDE_TOPICS=EcoCash
# Model for the short "is this about SMS alerts?" read (empty = AGENT_MODEL; a small model is enough,
# e.g. claude-haiku-4-5-20251001). Each ticket is read once, then again only after a new message from its owner.
TRIAGE_MODEL=
TRIAGE_MAX_PER_RUN=40
TRIAGE_MIN_CONFIDENCE=0.8

# ---- Investigation and approval ---------------------------------------------------------------
# Read-only lookups beyond the standard check (account activity, gateway messages, profile)
LOOKUPS_ENABLED=true
# Branch changes awaiting authorisation (Intellect maker-checker). One SELECT using {account}, {internal} or {client}.
# Empty = the lookup is hidden. Runs on the standby DB unless PENDING_CHANGES_DB_NAME names another Metabase database.
PENDING_CHANGES_SQL=
PENDING_CHANGES_DB_NAME=
# Which replies wait for a person in the console (live mode): off | unscripted (reasoned beyond the standard
# statuses, or an action the statuses don't lead to) | all
APPROVAL_MODE=unscripted

# ---- osTicket writes (the Java's --reply-staff-id / --close-status-id) -------------------
REPLY_STAFF_ID=525
CLOSE_STATUS_ID=3

# ---- Metabase (all data access goes through it) ---------------------------------------------
METABASE_HOST=http://192.168.243.65:3000
METABASE_API_KEY=
METABASE_TIMEOUT_SECONDS=180
METABASE_QUERY_RETRY_COUNT=3
METABASE_QUERY_RETRY_DELAY_MILLIS=5000

# Metabase database names (resolved to ids at the start of each run)
TICKET_DB_NAME=OSTICKETS_NEW
STANDBY_DB_NAME=STANDBY DB
CUSTOMERS_DB_NAME=CUSTOMERS
SOCKET_SMS_DB_NAME=SOCKET SMS DB
DISPATCH_SMS_DB_NAME=SMS

# ---- SMS checks (Java defaults) ----------------------------------------------------------------
STANDBY_REPLY_SOURCE_NAME=Intellect
SMS_LOOKBACK_DAYS=15
# Core banking keeps one transaction table per year; {year} is filled from the dates checked
TRAN_TABLE_PATTERN=NMBPRODIDC.TRAN{year}
SMS_SOCKET_CHECK_ENABLED=true
SMS_SOCKET_MATCH_WINDOW_MINUTES=60
SMS_SOCKET_DISPATCH_LAG_MINUTES=1080
SMS_SOCKET_OVERSEND_THRESHOLD=5
SMS_SOCKET_MAX_TRIGGERS=5
SMS_SALARIES_REQUIRE_DELIVERY_PROOF=false

# ---- Ticket attachments (screenshots, forms, PDFs, spreadsheets) ---------------------------
# model = text files read here, images and PDFs read by the model (the file itself is sent)
# local = text files only; images and PDFs listed, not read | off = ignore attachments
ATTACHMENT_MODE=model
# Empty = AGENT_MODEL
ATTACHMENT_MODEL=
ATTACHMENT_MAX_MB=10
# Files read per ticket; the ticket owner's newest files first
ATTACHMENT_MAX_FILES=6
# Inline images smaller than this are e-mail signature logos
ATTACHMENT_MIN_INLINE_KB=10
# How much text from one file the agent sees
ATTACHMENT_MAX_TEXT_CHARS=2500

# ---- Portal (python -m agent portal) ---------------------------------------------------
# Bind to localhost and publish through the F5 / nginx with TLS. Users: python -m agent portal-user add <name> --role admin
PORTAL_HOST=127.0.0.1
PORTAL_PORT=8085
PORTAL_USERS_FILE=state/portal_users.json
# The health strip (and GET /healthz) turns red when no pass has finished for this long
PORTAL_STALE_MINUTES=40
# Link ticket numbers to osTicket; {ticket_id} or {number} is filled in
OSTICKET_TICKET_URL=
# Optional: show model cost instead of tokens (your contracted price per million tokens)
PRICE_INPUT_PER_MTOK=
PRICE_OUTPUT_PER_MTOK=
# Escalate if the ticket owner has not answered the agent's question within this many hours
REQUEST_INFO_TIMEOUT_HOURS=72
# Written by the portal's "Hold the mode" control
MODE_OVERRIDE_FILE=state/MODE_OVERRIDE

# ---- Branch notifications ---------------------------------------------------------------
# The agent writes replies straight into osTicket, which sends no alert for them, so the agent
# emails the person who raised the ticket. Without this, a branch never sees the agent's questions.
# off | gateway (the bank notification gateway, same as the Java AdminNotifGateway) | smtp
# Leave empty to use the gateway whenever NOTIF_EMAIL_URL is set.
NOTIFY_TRANSPORT=
# Which outcomes email the ticket owner
NOTIFY_ON=request_info,reply_and_close
# Optional copy to a desk mailbox (comma separated)
NOTIFY_CC=
# Last line of every email; \n for a line break
NOTIFY_SIGNATURE=ICT Service Desk
# Link in the email for the branch to open the ticket; {ticket_id} or {number} is filled in
OSTICKET_CLIENT_URL=
# Give up on an email after this many tries (one try per pass)
NOTIFY_MAX_ATTEMPTS=5
# Email wording lives in templates/notify_request_info.txt and templates/notify_resolved.txt
TEMPLATE_DIR=templates

# gateway transport (values from the Java sms-agent.env)
NOTIF_EMAIL_URL=
NOTIF_EMAIL_ACCESS_TOKEN=
NOTIF_GATEWAY_BASIC_AUTH=

# smtp transport (lets branches answer by replying to the email, see README)
SMTP_HOST=
SMTP_PORT=25
SMTP_STARTTLS=true
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=SMS Alerts agent
# The mailbox osTicket fetches; replies to it with [#number] in the subject land on the ticket
NOTIFY_REPLY_TO=

# ---- Anomaly watch -----------------------------------------------------------------------
# Hourly look at ticket volume and alert delivery; alerts admins on an incident (see README)
ANOMALY_ENABLED=true
ANOMALY_INTERVAL_MINUTES=60
# Compare the last ANOMALY_WINDOW_HOURS with the same window on each of the last ANOMALY_BASELINE_DAYS
ANOMALY_WINDOW_HOURS=24
ANOMALY_BASELINE_DAYS=14
# Below these counts a change is not judged (too few to mean anything)
ANOMALY_MIN_TICKETS=5
ANOMALY_MIN_SENDS=200
# Failed and delivered gateway messages sampled for the comparison, each
ANOMALY_SAMPLE_SIZE=600
# Alert admins at: incident | watch
ANOMALY_ALERT_LEVEL=incident
# Remind admins while an incident lasts
ANOMALY_REALERT_HOURS=4
# Empty = AGENT_MODEL
ANOMALY_MODEL=
ANOMALY_PROMPT_FILE=prompts/anomaly_prompt.md

# ---- Admin alerts (anomaly incidents) ----------------------------------------------------------
# Comma separated; SMS go through the gateway (Java AdminNotifGateway), email through NOTIFY_TRANSPORT
ADMIN_SMS_RECIPIENTS=
ADMIN_EMAIL_RECIPIENTS=
NOTIF_SMS_URL=
NOTIF_SMS_ACCESS_TOKEN=
NOTIF_SMS_ORIGINATOR=NMB Bank
# Portal address put in alerts, e.g. https://smsagent.nmbz.co.zw
PORTAL_URL=
