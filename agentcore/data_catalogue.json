{
  "about": "Approved tables for query_data, the agents' general read-only look into the bank's databases. Only what is listed here can be read: no personal columns (names, ID numbers, e-mails, addresses, card numbers, PINs, OTPs) and no free-text request/response bodies. 'identifiers' are the columns a query may be matched on, with the kind of value the ticket must give (account, mobile, reference, cif); 'time' is the column a query's window applies to; 'columns' are the columns that may be shown, filtered or counted. 'open' tables hold no client data and may be read without a match. Built from reports/catalogue (tools/metabase_names.py --catalogue).",
  "sources": {
    "zipit_middleware": {
      "database": "Postilion Billers",
      "table": "public.zipit",
      "desks": [
        "failed_txn"
      ],
      "about": "ZIPIT transfers to other banks as the payments middleware logged them (NMB Connect, USSD, internet banking): the debit, the switch response and the error. debit_account_error is core banking's error on the debit; postilion_resp_code is the switch's response.",
      "time": {
        "column": "date_created",
        "type": "timestamp",
        "max_days": 31
      },
      "order_by": "date_created",
      "identifiers": {
        "source_account": "account",
        "debited_account": "account",
        "destination_account": "account",
        "rrn": "reference",
        "reference": "reference",
        "nmb_reference": "reference",
        "customer_reference": "reference"
      },
      "columns": [
        "date_created",
        "transaction_date",
        "amount",
        "currency",
        "channel",
        "operation",
        "status",
        "error_code",
        "debit_account_error",
        "postilion_resp_code",
        "postilion_resp_msg_type",
        "receiver_bank",
        "destination_bank_bin",
        "source_account",
        "debited_account",
        "destination_account",
        "rrn",
        "reference",
        "nmb_reference",
        "customer_reference"
      ]
    },
    "internal_transfer_middleware": {
      "database": "Postilion Billers",
      "table": "public.internal_transfer",
      "desks": [
        "failed_txn"
      ],
      "about": "Transfers between NMB accounts (and tap-card transfers) as the payments middleware logged them, with status and error code.",
      "time": {
        "column": "date_created",
        "type": "timestamp",
        "max_days": 31
      },
      "order_by": "date_created",
      "identifiers": {
        "source_account": "account",
        "destination_account": "account",
        "rrn": "reference",
        "reference": "reference",
        "nmb_reference": "reference",
        "customer_reference": "reference"
      },
      "columns": [
        "date_created",
        "transaction_date",
        "amount",
        "currency",
        "channel",
        "transfer_type",
        "status",
        "error_code",
        "source_account",
        "destination_account",
        "rrn",
        "reference",
        "nmb_reference",
        "customer_reference"
      ]
    },
    "rtgs_middleware": {
      "database": "Postilion Billers",
      "table": "public.rtgs",
      "desks": [
        "failed_txn"
      ],
      "about": "RTGS transfers from the digital channels as the payments middleware logged them: status, the reason when it failed, and the T24 FT reference.",
      "time": {
        "column": "date_created",
        "type": "timestamp",
        "max_days": 31
      },
      "order_by": "date_created",
      "identifiers": {
        "debit_account_number": "account",
        "credit_account_number": "account",
        "beneficiary_account_number": "account",
        "reference": "reference",
        "debit_reference": "reference",
        "t24ftid": "reference"
      },
      "columns": [
        "date_created",
        "transaction_date",
        "amount",
        "currency",
        "bank",
        "channel",
        "status",
        "reason",
        "debit_value_date",
        "credit_value_date",
        "debit_account_number",
        "credit_account_number",
        "beneficiary_account_number",
        "reference",
        "debit_reference",
        "t24ftid"
      ]
    },
    "zimra_payments": {
      "database": "Postilion Billers",
      "table": "public.zimra",
      "desks": [
        "failed_txn"
      ],
      "about": "ZIMRA tax and customs payments (domestic and customs/port of entry): status and reason, the BP number and ZIMRA's own references.",
      "time": {
        "column": "date_created",
        "type": "timestamp",
        "max_days": 31
      },
      "order_by": "date_created",
      "identifiers": {
        "source_account": "account",
        "target_account": "account",
        "business_partner_number": "reference",
        "reference": "reference",
        "beneficiary_reference": "reference",
        "req_id": "reference",
        "request_id": "reference",
        "zimra_internal_id": "reference"
      },
      "columns": [
        "date_created",
        "transaction_date",
        "amount",
        "currency",
        "channel",
        "last_updated_channel",
        "type",
        "status",
        "reason",
        "customer_number",
        "business_partner_number",
        "source_account",
        "target_account",
        "reference",
        "beneficiary_reference",
        "req_id",
        "request_id",
        "zimra_internal_id"
      ]
    },
    "econet_airtime": {
      "database": "BILLERS",
