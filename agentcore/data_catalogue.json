    "connect_fraud_alerts": {
      "database": "CONECT 2.0 REG",
      "table": "public.fraud_alerts",
      "desks": [
        "nmb_connect"
      ],
      "about": "NMB Connect fraud alerts on a profile or mobile: type, severity, risk score, channel and activity, and whether and when it was resolved (which can explain a blocked profile). No alert details or device data.",
      "time": {
        "column": "created_at",
        "type": "timestamp",
        "max_days": 90
      },
      "order_by": "created_at",
      "identifiers": {
        "mobile_number": "mobile",
        "customer_mobile": "mobile",
        "customer_cif": "cif"
      },
      "via": {
        "customer_mobile": {
          "column": "customer_id",
          "table": "public.customers",
          "key": "id",
          "lookup": "mobile_number"
        },
        "customer_cif": {
          "column": "customer_id",
          "table": "public.customers",
          "key": "id",
          "lookup": "customer_number"
        }
      },
      "columns": [
        "created_at",
        "alert_type",
        "severity",
        "risk_score",
        "channel",
        "activity",
        "status",
        "is_resolved",
        "resolved_at",
        "mobile_number"
      ]
    }
  }
}
