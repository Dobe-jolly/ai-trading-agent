      ]
    },
    "zesa_tokens": {
      "database": "BILLERS",
      "table": "public.esol_zesa_payment",
      "desks": [
        "failed_txn"
      ],
      "about": "ZESA prepaid electricity purchases: status, ZESA's response code and reason, the receipt number, and whether a token was issued (token_issued; the token itself is not shown).",
      "time": {
        "column": "date_created",
        "type": "timestamp",
        "max_days": 31
      },
      "order_by": "date_created",
      "identifiers": {
        "source_account": "account",
        "utility_account": "account",
        "account_number": "account",
        "target_mobile": "mobile",
        "reference": "reference",
        "transaction_reference": "reference",
        "vendor_reference": "reference",
        "receipt_number": "reference",
        "original_reference": "reference"
      },
      "columns": [
        "date_created",
        "transaction_amount",
        "currency_code",
        "payment_currency",
        "meter_currency",
        "channel",
        "status",
        "response_code",
        "reason",
        "product_name",
        "sub_product_name",
        "payment_type",
        "retry_count",
        "zesa_provider",
        "aggregator",
        "source_account",
        "utility_account",
        "account_number",
        "target_mobile",
        "reference",
        "transaction_reference",
        "vendor_reference",
        "receipt_number",
        "original_reference"
      ],
      "computed": {
        "token_issued": "CASE WHEN COALESCE(token, '') <> '' THEN 'yes' ELSE 'no' END"
      }
    },
    "intellect_api_errors": {
      "database": "intellect_errors",
      "table": "public.error_log",
      "desks": [
        "failed_txn"
      ],
      "about": "Errors the channels' core banking (Intellect) interface logged: the operation, error code and message, category and severity, for transfers, payments and loans from the digital channels and branches.",
      "time": {
        "column": "received_at",
        "type": "timestamp",
        "max_days": 31
      },
      "order_by": "received_at",
      "identifiers": {
        "account_number": "account",
        "debtor_account": "account",
        "creditor_account": "account",
        "customer_id": "cif",
        "reference_number": "reference",
        "request_id": "reference",
        "correlation_id": "reference"
      },
      "columns": [
        "received_at",
        "transaction_date",
        "transaction_time",
        "amount",
        "currency",
        "channel",
        "operation",
        "business_operation",
        "transaction_type",
        "status",
        "status_code",
        "error_code",
        "error_message",
        "error_category",
        "error_type",
        "error_severity",
        "reason",
        "message",
        "service_name",
        "is_retryable",
        "account_number",
        "debtor_account",
        "creditor_account",
        "customer_id",
        "reference_number",
        "request_id",
        "correlation_id"
      ]
    },
    "ecocash_registration_failures": {
      "database": "Ecocash erros",
      "table": "public.failed_ecocash_registrations",
      "desks": [
        "failed_txn"
      ],
      "about": "EcoCash link (registration) attempts that failed, with EcoCash's or the bank's error message, per account, mobile and currency.",
      "time": {
        "column": "failure_timestamp",
        "type": "timestamp",
        "max_days": 90
      },
      "order_by": "failure_timestamp",
      "identifiers": {
        "account_number": "account",
        "mobile_number": "mobile"
      },
      "columns": [
        "failure_timestamp",
        "created_at",
        "currency",
        "error_message",
        "account_number",
        "mobile_number"
      ]
    },
    "ft_reversals": {
