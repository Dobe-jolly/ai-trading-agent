    "channel_limits_by_category": {
      "database": "connectorservices",
      "table": "public.limits_by_categ",
      "desks": [
        "failed_txn"
      ],
      "open": true,
      "about": "The channel transaction limits set per account category (no client data).",
      "order_by": "id",
      "identifiers": {},
      "columns": [
        "category",
        "limit_amount",
        "status",
        "date_created",
        "time_created"
      ]
    },
    "sms_dispatch_messages": {
      "database": "SMS",
      "table": "public.sms_message",
      "desks": [
        "sms_alerts"
      ],
      "about": "Every SMS the bank's SMS dispatch service sent or tried to send (alerts, OTPs): dispatch status, the provider and its references, and the failure reason. Matched by the recipient's mobile. The message text is not shown.",
      "time": {
        "column": "created_at",
        "type": "timestamp",
        "max_days": 14
      },
      "order_by": "created_at",
      "identifiers": {
        "recipient_mobile": "mobile",
        "provider_message_id": "reference",
        "provider_reference": "reference"
      },
      "via": {
        "recipient_mobile": {
          "column": "recipient_id",
          "table": "public.sms_recipient",
          "key": "id",
          "lookup": "mobile_number"
        }
      },
      "columns": [
        "created_at",
        "dispatched_at",
        "updated_at",
        "channel",
        "operation",
        "dispatch_status",
        "failure_reason",
        "provider_name",
        "provider_message_id",
        "provider_reference",
        "request_key",
        "source_request_key"
      ]
    },
    "sms_recipients": {
      "database": "SMS",
      "table": "public.sms_recipient",
      "desks": [
        "sms_alerts"
      ],
      "about": "The SMS dispatch service's recipients: whether SMS is enabled for the mobile, and when it was added or changed.",
      "order_by": "id",
      "identifiers": {
        "mobile_number": "mobile"
      },
      "columns": [
        "mobile_number",
        "sms_enabled",
        "created_at",
        "updated_at"
      ]
    },
    "connect_profiles": {
      "database": "CONECT 2.0 REG",
      "table": "public.customers",
      "desks": [
        "nmb_connect"
      ],
      "about": "NMB Connect profiles: status and active flag, the channel and source of registration, when registered and changed, the KYC document statuses, notification settings and preferred contact. No names, ID, e-mail, address or device details.",
      "order_by": "id",
      "identifiers": {
        "customer_number": "cif",
        "mobile_number": "mobile"
      },
      "columns": [
        "customer_number",
        "mobile_number",
        "status",
        "active",
        "channel",
        "source_reg",
        "registration_date",
        "date_created",
        "date_modified",
        "last_update_date",
        "daily_update_count",
        "preferred_contact",
        "kyc_proof_of_residence_status",
        "kyc_proof_of_employment_status",
        "kyc_id_front_status",
        "kyc_id_back_status",
        "kyc_selfie_status",
        "sms_notifications_enabled",
        "in_app_notifications_enabled"
      ]
    },
    "connect_channel_enrollments": {
      "database": "CONECT 2.0 REG",
