    "connect_credential_status": {
      "database": "CONECT 2.0 REG",
      "table": "public.credential_status",
      "desks": [
        "nmb_connect"
      ],
      "about": "Credentials enabled or disabled on an NMB Connect profile per channel (PIN, password, biometrics...), with the reason and when. The credential itself is never shown.",
