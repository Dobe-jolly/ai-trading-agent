      ],
      "about": "Which channels (app, USSD, web) an NMB Connect profile is enrolled on, the status, whether a first login is still required, and when it was activated.",
      "order_by": "date_created",
      "identifiers": {
        "customer_mobile": "mobile",
        "customer_cif": "cif"
      },
      "via": {
        "customer_mobile": {
          "column": "customer_id",
          "table": "public.customers",
          "key": "id",
          "lookup": "mobile_number"
        },
        "customer_cif": {
          "column": "customer_id",
          "table": "public.customers",
          "key": "id",
          "lookup": "customer_number"
        }
      },
      "columns": [
        "channel",
        "status",
        "first_login_required",
        "activated_at",
        "date_created",
        "date_modified"
      ]
    },
    "connect_user_channels": {
      "database": "CONECT 2.0 REG",
      "table": "public.user_channels",
      "desks": [
        "nmb_connect"
      ],
      "about": "The login per channel of an NMB Connect profile: active or not, failed login attempts, WhatsApp consent, when created and changed. No username or password.",
      "order_by": "date_modified",
