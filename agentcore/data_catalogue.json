    "card_requests": {
      "database": "CARD ISSUANCE",
      "table": "public.card_request",
      "desks": [
        "failed_txn"
      ],
      "about": "Card requests at the branches: new, replacement and duplicate cards, with the card type, operation, issue type and status. Card numbers are not shown.",
      "order_by": "id",
      "identifiers": {
        "account_number": "account",
        "cif": "cif",
        "reference": "reference"
      },
      "columns": [
        "date_created",
        "allocation_date",
        "card_type",
        "card_operation",
        "card_option",
        "issue_type",
        "card_program",
        "category",
        "currency",
        "status",
        "branch",
        "reference",
        "account_number",
        "cif"
      ]
