# Copy to /etc/ecocash-agent/agent.env (systemd) or .env (manual runs) and fill in.
# One KEY=value per line, no spaces around "=", no inline comments, no quotes.
# Names shared with the SMS agent (METABASE_*, NOTIF_*, ADMIN_*, ATTACHMENT_*) mean the same, so values can be copied.

# ---- Claude (the reasoning) -----------------------------------------------------
ANTHROPIC_API_KEY=
AGENT_MODEL=claude-sonnet-5-5
# If Claude cannot be reached: rules = standard reply for tickets under an EcoCash topic, escalate when the
# branch has answered the agent; none = leave every ticket for the next run.
MODEL_FALLBACK=rules

# ---- Behaviour ------------------------------------------------------------------------
# shadow = decide and log only | notes = internal recommendation notes | live = reply/close/escalate
AGENT_MODE=shadow
CONFIDENCE_THRESHOLD=0.85
MAX_TICKETS_PER_RUN=25
MAX_CLOSES_PER_RUN=20
# Ask the branch for missing details (and to delink first) instead of escalating
ALLOW_REQUEST_INFO=true
# Agent replies on one ticket before a person takes over
MAX_INFO_REQUESTS=2
# model = Claude writes the reply | template = post the standard reply for the latest attempt
REPLY_SOURCE=model
# Re-examine an unchanged open ticket after this many hours (a retry may have worked meanwhile)
RECHECK_AFTER_HOURS=24
# Escalate if the branch has not answered the agent's question within this many hours
REQUEST_INFO_TIMEOUT_HOURS=72
# If this file exists the agent does nothing: touch it to stop, rm it to resume
KILL_SWITCH_FILE=state/STOP
# Written by the portal's "Hold the mode" control
MODE_OVERRIDE_FILE=state/MODE_OVERRIDE

# ---- Which tickets ------------------------------------------------------------------------
# Help topics (and their subtopics) the agent owns
ECOCASH_HELP_TOPICS=EcoCash
# Also open tickets under other topics whose subject or owner messages mention these, created in the last
# ECOCASH_CONTENT_DAYS days; they cost no model call unless the owner's details have a link attempt
ECOCASH_KEYWORDS=ecocash,eco cash
ECOCASH_CONTENT_DAYS=30
# Never touched (the SMS agent owns SMS Alerts)
ECOCASH_EXCLUDE_TOPICS=SMS Alerts
# How far back the lookups go
ECOCASH_LOOKBACK_DAYS=60

# ---- Investigation and approval ---------------------------------------------------------------
# Branch changes awaiting authorisation (Intellect maker-checker), on the core-banking database.
# One SELECT using {account}, {internal} or {client}. Empty = the lookup is hidden.
PENDING_CHANGES_SQL=
# Which replies wait for a person in the console (live mode): off | unscripted (reasoned beyond the standard
# reply for the latest attempt, or an action it doesn't give) | all
APPROVAL_MODE=unscripted

# ---- osTicket writes ---------------------------------------------------------------------
# The staff account the agent posts as (create one for it); required for notes and live
REPLY_STAFF_ID=
CLOSE_STATUS_ID=3

# ---- Metabase (all the agent's data access goes through it) ----------------------------------
METABASE_HOST=http://192.168.243.65:3000
METABASE_API_KEY=
METABASE_TIMEOUT_SECONDS=180
METABASE_QUERY_RETRY_COUNT=3
METABASE_QUERY_RETRY_DELAY_MILLIS=5000
METABASE_VERIFY_TLS=true
# Database names as Metabase shows them
TICKET_DB_NAME=OSTICKETS_NEW
ECOCASH_DB_NAME=ecocash_monitor
POSTILION_DB_NAME=POSTILION
STANDBY_DB_NAME=STANDBY DB
ECOCASH_ATTEMPTS_TABLE=ecocash_link_attempts
# The Java monitor's failures table, read for history from before the switch (empty = don't)
ECOCASH_LEGACY_TABLE=failed_ecocash_registrations
POSTILION_ECOCASH_TABLE=eftc_ecocash
# Optional core-banking extras, run with {internal} (internal account) and {client} (client number), e.g.
# CORE_SQL_ID_ON_FILE=SELECT PIDDOCS_PID_TYPE, PIDDOCS_DOCID_NUM FROM PIDDOCS WHERE PIDDOCS_SOURCE_KEY = '{client}'
CORE_SQL_ACCOUNT_STATUS=
CORE_SQL_ID_ON_FILE=

# ---- Attachments (screenshots, ID copies, PDFs, spreadsheets) --------------------------------
# model = text files read here, images and PDFs read by the model (the file itself is sent)
# local = text files only; images and PDFs listed, not read | off = ignore attachments
ATTACHMENT_MODE=model
ATTACHMENT_MODEL=
ATTACHMENT_MAX_MB=10
ATTACHMENT_MAX_FILES=6
ATTACHMENT_MIN_INLINE_KB=10
ATTACHMENT_MAX_TEXT_CHARS=2500

# ---- Portal (python -m agent portal) --------------------------------------------------------
# Port 8086, so it can run next to the SMS agent's portal (8085). Publish through the F5/nginx with TLS.
PORTAL_HOST=127.0.0.1
PORTAL_PORT=8086
PORTAL_USERS_FILE=state/portal_users.json
PORTAL_STALE_MINUTES=40
OSTICKET_TICKET_URL=
PRICE_INPUT_PER_MTOK=
PRICE_OUTPUT_PER_MTOK=

# ---- Branch e-mails ------------------------------------------------------------------------
# off | gateway (bank notification gateway) | smtp. Empty = gateway when NOTIF_EMAIL_URL is set.
NOTIFY_TRANSPORT=
NOTIFY_ON=request_info,reply_and_close
NOTIFY_CC=
NOTIFY_SIGNATURE=ICT Service Desk
OSTICKET_CLIENT_URL=
NOTIFY_MAX_ATTEMPTS=5
TEMPLATE_DIR=templates
NOTIF_EMAIL_URL=
NOTIF_EMAIL_ACCESS_TOKEN=
NOTIF_GATEWAY_BASIC_AUTH=
SMTP_HOST=
SMTP_PORT=25
SMTP_STARTTLS=true
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=EcoCash agent
NOTIFY_REPLY_TO=

# ---- Anomaly watch and admin alerts ------------------------------------------------------------
ANOMALY_ENABLED=true
ANOMALY_INTERVAL_MINUTES=60
ANOMALY_WINDOW_HOURS=24
ANOMALY_BASELINE_DAYS=14
ANOMALY_MIN_TICKETS=5
# Below this many link requests in 24 h, rates are not judged
ANOMALY_MIN_ATTEMPTS=30
ANOMALY_SAMPLE_SIZE=400
ANOMALY_ALERT_LEVEL=incident
ANOMALY_REALERT_HOURS=4
ANOMALY_MODEL=
ANOMALY_PROMPT_FILE=prompts/anomaly_prompt.md
ADMIN_SMS_RECIPIENTS=
ADMIN_EMAIL_RECIPIENTS=
NOTIF_SMS_URL=
NOTIF_SMS_ACCESS_TOKEN=
NOTIF_SMS_ORIGINATOR=NMB Bank
PORTAL_URL=
