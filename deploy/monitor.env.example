# /etc/nmbz-agents/monitor.env on the integrations host (the EcoCash monitor only; it needs no Claude key).
# postgres = direct connection (as the Java monitor had) | metabase = through the Metabase API
MONITOR_STORE=postgres
# The Java monitor's settings are read as they are: DB_URL, DB_USERNAME, DB_PASSWORD
DB_URL=jdbc:postgresql://192.168.254.146:5422/ecocash_monitor
DB_USERNAME=
DB_PASSWORD=
# Or instead: MONITOR_DB_URL=postgresql://user:password@host:5422/ecocash_monitor
MONITOR_UNIT=ecocashreg.service
MONITOR_POSITION_FILE=state/ecocash/journal-position.json
# A request with no answer from EcoCash after this long is recorded as no_response
MONITOR_NO_RESPONSE_SECONDS=180
# Keep writing failed links to the Java's failed_ecocash_registrations table too
MONITOR_LEGACY_TABLE=true
# Only for MONITOR_STORE=metabase
METABASE_HOST=http://192.168.243.65:3000
METABASE_API_KEY=
ECOCASH_DB_NAME=ecocash_monitor
