[Unit]
Description=EcoCash monitor: records every EcoCash link and delink request (replaces ecocash-registration-monitor)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# A dedicated user that may read the journal (the Java monitor ran as root).
User=ecomonitor
Group=ecomonitor
SupplementaryGroups=systemd-journal
WorkingDirectory=/opt/nmbz-agents
EnvironmentFile=/etc/nmbz-agents/monitor.env
ExecStart=/opt/nmbz-agents/.venv/bin/python -m nmbz monitor
Restart=always
RestartSec=5
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/nmbz-agents/state

[Install]
WantedBy=multi-user.target
