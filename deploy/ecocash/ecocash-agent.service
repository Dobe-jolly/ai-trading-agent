[Unit]
Description=EcoCash agent (one pass over EcoCash tickets, then the anomaly watch)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=ecoagent
Group=ecoagent
WorkingDirectory=/opt/ecocash-agent
EnvironmentFile=/etc/ecocash-agent/agent.env
ExecStart=/opt/ecocash-agent/.venv/bin/python -m agent run
TimeoutStartSec=1800
# Exit 3 = finished but some tickets errored (they are retried next run).
SuccessExitStatus=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/ecocash-agent/state /opt/ecocash-agent/reports
